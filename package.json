{
  "name": "playwright-ecommerce-pom",
  "version": "1.0.0",
  "description": "End-to-End E-Commerce Test Automation Suite using Playwright, TypeScript, Page Object Model (POM), and GitHub Actions CI.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa-automation",
    "page-object-model",
    "e2e-testing",
    "ci-cd"
  ],
  "author": "Mateo Pimienta",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  }
}
